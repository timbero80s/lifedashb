# Copy the values you have into Netlify:
#   Site configuration -> Environment variables -> Add a variable
# (Do NOT commit real values. This file is only a template.)

# --- Calendar -------------------------------------------------------------
# Google Calendar -> each calendar's Settings -> "Secret address in iCal format".
# Paste one or more, comma-separated, no spaces around the commas.
CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/xxxxx/private-yyyy/basic.ics

# --- Football (Tottenham table + fixtures) ------------------------------
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# thesportsdb (Maidenhead Utd + Ferro). "3" is the free test key and is the
# default if you leave this blank. A Patreon key unlocks next-fixture data.
SPORTSDB_KEY=3

# --- Trains (Realtime Trains) -----------------------------------------
# Free personal account: https://api.rtt.io/  (Account -> "Create API auth credential")
RTT_USERNAME=
RTT_PASSWORD=
# Optional overrides (defaults: MAI = Maidenhead, PAD = London Paddington)
TRAIN_STATION=MAI
TRAIN_LONDON=PAD

# --- ISS passes ------------------------------------------------------
# Optional. Free key: https://www.n2yo.com/api/  (better data).
# If blank, a keyless fallback API is used automatically.
N2YO_API_KEY=
